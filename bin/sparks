#!/usr/bin/env bash
# Backing store for the ollywarren.sparks plugin: list, create, edit and hand
# off idea .md files. Plain files are the source of truth -- no index/database
# -- so the folder stays greppable and safe to hand to an agent as-is.
#
# Usage:
#   sparks list   <dir>                      -> JSON array, newest first
#   sparks new    <dir> <text>               -> writes a new idea, prints {"file":...}
#   sparks remove <dir> <file>               -> deletes one idea file
#   sparks open   <file>                     -> opens it in the markdown app
#   sparks set    <dir> <file> <key> <value> -> rewrites one frontmatter field
#   sparks search <dir> <query>              -> JSON array of matching file paths
#   sparks tags   <dir>                      -> JSON array of {tag, count}
#   sparks related <dir> <file>              -> up to 3 siblings that overlap it
#   sparks reviewed <dir> <file>             -> marks a brief as written
#   sparks review <dir> <file> --confirmed [--mode M]
#                                            -> hands the idea to the default agent
#   sparks create <dir> <file> [projectsDir] --confirmed [--mode M]
#                                            -> scaffolds a workspace, hands it over
#
# The two handoffs launch an agent that can act on this machine, so neither
# runs without --confirmed: the panel passes it only after its confirm dialog,
# and anyone typing it has said yes themselves. --mode is plan (the default:
# read-only, proposes before acting), ask (prompts before each action) or auto
# (Omarchy's own auto-approve launch). SPARKS_DRY_RUN=1 prints the agent argv
# instead of launching it.
set -euo pipefail

NOTIFIED=false

notify() {
  NOTIFIED=true
  omarchy-notification-send --app-name "Sparks" -t 4000 "$1" "${2:-}" >/dev/null 2>&1 || true
}

# The commands that end in a window of their own are launched detached by the
# panel, so nothing is reading our stderr: a bare `fail` there would be silent.
# Those get a notification as well as the log line -- unless one has already
# gone out, since the specific cases below word it better than "$*" does. This
# generic one is for the paths nobody anticipated.
fail() {
  echo "sparks: $*" >&2
  case "${cmd:-}" in
    review | create)
      [[ $NOTIFIED == true ]] || notify "Couldn't hand this idea over" "$*"
      ;;
    open)
      [[ $NOTIFIED == true ]] || notify "Couldn't open this idea" "$*"
      ;;
  esac
  exit 1
}

# Detach and return, rather than `exec` into the launch. The chain from here
# -- omarchy-launch-tui, `setsid uwsm-app`, `systemd-run --scope` -- is all
# exec and no fork, so without `--fork` the terminal emulator inherits this
# PID. That matters because our caller is a Quickshell `Process`, which owns
# the PID it spawned: it stays `running` for as long as the agent's window is
# open (blocking further handoffs) and kills it whenever the bar widget is
# torn down for a theme change or a monitor event. `--fork` plus closed stdio
# makes the agent nobody's child.
detach() {
  if [[ ${SPARKS_DRY_RUN:-} == 1 ]]; then
    printf '%q ' "$@"
    echo
    return 0
  fi
  setsid --fork "$@" </dev/null >/dev/null 2>&1
}

# The argv for the default agent in plan or ask mode, into AGENT_CMD. Omarchy's
# own launcher (omarchy-agent) starts every agent with its auto-approve flag,
# so these modes can't go through it; the per-agent spellings below mirror its
# prompt handling and swap only the permission flag.
#
# An agent with no read-only mode gets ask instead, and one that can't prompt
# at all is refused: a handoff is never quietly more permissive than the mode
# the user picked. Sets AGENT_MODE_USED to what the agent actually got.
agent_command() {
  local agent="$1" mode="$2" prompt="$3"
  AGENT_CMD=()
  AGENT_MODE_USED=$mode

  case "$agent" in
    omp | hermes | muse) [[ $mode == plan ]] && AGENT_MODE_USED=ask ;;
  esac

  case "$agent:$AGENT_MODE_USED" in
    claude:plan)       AGENT_CMD=(claude --permission-mode plan -- "$prompt") ;;
    claude:ask)        AGENT_CMD=(claude --permission-mode manual -- "$prompt") ;;
    codex:plan)        AGENT_CMD=(codex --sandbox read-only --ask-for-approval on-request -- "$prompt") ;;
    codex:ask)         AGENT_CMD=(codex --sandbox workspace-write --ask-for-approval on-request -- "$prompt") ;;
    gemini:plan)       AGENT_CMD=(gemini --approval-mode plan --prompt-interactive "$prompt") ;;
    gemini:ask)        AGENT_CMD=(gemini --approval-mode default --prompt-interactive "$prompt") ;;
    grok:plan)         AGENT_CMD=(grok --permission-mode plan -- "$prompt") ;;
    grok:ask)          AGENT_CMD=(grok --permission-mode default -- "$prompt") ;;
    opencode:plan)     AGENT_CMD=(opencode --agent plan --prompt "$prompt") ;;
    opencode:ask)      AGENT_CMD=(opencode --prompt "$prompt") ;;
    copilot:plan)      AGENT_CMD=(copilot --mode plan --interactive "$prompt") ;;
    copilot:ask)       AGENT_CMD=(copilot --mode interactive --interactive "$prompt") ;;
    # A one-word prompt naming a subcommand would still run it, so the agent
    # subcommand is named outright -- as omarchy-agent does.
    cursor-agent:plan) AGENT_CMD=(cursor-agent --mode plan agent -- "$prompt") ;;
    cursor-agent:ask)  AGENT_CMD=(cursor-agent agent -- "$prompt") ;;
    omp:ask)           AGENT_CMD=(omp -- "$prompt") ;;
    hermes:ask)        AGENT_CMD=(env -u HERMES_SESSION_SOURCE hermes chat --tui "--query=$prompt") ;;
    muse:ask)          AGENT_CMD=(muse --approval-mode untrusted -- "$prompt") ;;
    # Everything else is refused: pi and openclaw have no approval prompts at
    # all, and crush only takes a prompt through `crush run`, which never asks.
    *)                 return 1 ;;
  esac
}

# Hand the prompt to the user's default agent in the given mode, in a terminal
# of its own. auto goes through omarchy-agent-prompt so it keeps whatever flags
# Omarchy ships; plan and ask are launched the same way omarchy-agent does it,
# window class included, so window rules for agents still apply.
launch_agent() {
  local mode="$1" prompt="$2" agent
  agent=$(omarchy-default-agent 2>/dev/null || true)

  if [[ $mode == auto ]]; then
    detach omarchy-agent-prompt "$prompt"
    return 0
  fi

  agent_command "$agent" "$mode" "$prompt"
  if [[ $AGENT_MODE_USED != "$mode" ]]; then
    notify "$agent has no plan mode" "Starting it in ask mode: it will prompt before each action."
  fi
  detach omarchy-launch-tui --app-id=org.omarchy.agent "${AGENT_CMD[@]}"
}

# Pulls --confirmed and --mode out of the handoff arguments, leaving the
# positional ones in ARGS. Sets CONFIRMED and MODE.
parse_handoff_flags() {
  CONFIRMED=false
  MODE=plan
  ARGS=()
  while (($#)); do
    case "$1" in
      --confirmed) CONFIRMED=true ;;
      --mode)      MODE="${2:-}"; shift ;;
      --mode=*)    MODE="${1#--mode=}" ;;
      *)           ARGS+=("$1") ;;
    esac
    shift
  done
  case "$MODE" in
    plan | ask | auto) ;;
    *) MODE=plan ;;
  esac
}

require_confirmed() {
  [[ $CONFIRMED == true ]] \
    || fail "agent handoff needs explicit confirmation -- pass --confirmed"
}

# Checked before anything is written, so a refused agent can't leave behind a
# scaffolded workspace or a status change.
require_agent_mode() {
  local mode="$1" agent
  [[ $mode == auto ]] && return 0
  agent=$(omarchy-default-agent 2>/dev/null || true)
  if ! agent_command "$agent" "$mode" ""; then
    notify "$agent can't run in plan or ask mode" \
      "Pick Auto in the Sparks settings, or another default agent."
    fail "$agent has no plan or ask mode -- choose auto, or another default agent"
  fi
}

# The plugin directory, resolved from this script rather than hardcoded, so a
# clone under a different name still finds its own skills.
SPARKS_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

cmd="${1:-}"
dir="${2:-}"
[[ -n $cmd ]] || fail "missing command"
[[ -n $dir ]] || fail "missing ideas directory"

# Every command that touches a named file goes through this: it resolves both
# paths and refuses anything that isn't inside the ideas folder. Sets REAL_DIR
# and REAL_FILE for the caller.
resolve_in_dir() {
  REAL_DIR=$(realpath -e "$1") || fail "ideas dir not found: $1"
  REAL_FILE=$(realpath -e "$2") || fail "file not found: $2"
  [[ $REAL_FILE == "$REAL_DIR"/* ]] || fail "refusing to touch a file outside the ideas dir"
}

# Frontmatter is our own fixed format (see `new`) -- a `---` fence on line 1,
# `key: value` lines, a closing `---`. One awk pass beats a sed call per field.
fm_all() {
  awk '
    NR==1 && $0=="---" { fm=1; next }
    fm && $0=="---"    { exit }
    fm {
      i = index($0, ": ")
      if (i > 0) print substr($0, 1, i-1) "\t" substr($0, i+2)
    }
  ' "$1"
}

fm_get() {
  local f="$1" key="$2" k v
  while IFS=$'\t' read -r k v; do
    [[ $k == "$key" ]] && { printf '%s' "$v"; return 0; }
  done < <(fm_all "$f")
  return 0
}

# Replace a frontmatter line in place, insert it before the closing fence if
# absent, or drop it when the value is empty. Written to a temp file in the
# same directory and moved over, so a crash can't leave a half-written idea.
fm_set() {
  local f="$1" key="$2" value="$3" tmp
  tmp=$(mktemp "$(dirname "$f")/.sparks-set.XXXXXX")
  awk -v key="$key" -v val="$value" '
    BEGIN { fm = 0; done = 0 }
    NR==1 && $0=="---" { fm=1; print; next }
    fm==1 && $0=="---" {
      if (!done && val != "") print key ": " val
      fm=2; print; next
    }
    fm==1 && index($0, key ": ")==1 {
      if (val != "") print key ": " val
      done=1; next
    }
    { print }
  ' "$f" > "$tmp"
  chmod --reference="$f" "$tmp" 2>/dev/null || true
  mv -- "$tmp" "$f"
}

# The first line of the captured text: everything before it is frontmatter or
# the literal "## Idea" heading. Falls through unchanged for idea files saved
# before that heading existed.
idea_title() {
  awk 'BEGIN{fm=0} /^---$/{fm++; next} fm<2{next} $0=="## Idea"{next} NF{print; exit}' "$1"
}

# True when any planning heading has been filled in. Checked by `create`
# rather than the status field, so an idea whose brief was written by hand --
# before statuses existed -- still counts as reviewed.
brief_filled() {
  awk '
    /^## (Context|Goal|Constraints|Open questions|Plan)$/ { inp=1; next }
    /^## /                                                { inp=0 }
    inp && NF                                             { found=1 }
    END { exit(found ? 0 : 1) }
  ' "$1"
}

require_agent() {
  command -v omarchy-agent-prompt >/dev/null 2>&1 \
    || fail "omarchy-agent-prompt not found -- needs Omarchy 4.x"
  [[ -n $(omarchy-default-agent 2>/dev/null || true) ]] \
    || { notify "No default agent" "Pick one with: omarchy default agent <name>"
         fail "no default agent set (omarchy default agent <name>)"; }
}

# Emit one idea file as a JSON object.
parse_one() {
  local f="$1" k v title mtime tags_json
  local created="" tags="" status="" planned="" project=""
  while IFS=$'\t' read -r k v; do
    case "$k" in
      created) created=$v ;;
      tags)    tags=$v ;;
      status)  status=$v ;;
      planned) planned=$v ;;
      project) project=$v ;;
    esac
  done < <(fm_all "$f")
  title=$(idea_title "$f")
  mtime=$(stat -c %Y "$f" 2>/dev/null || echo 0)
  tags_json=$(jq -cn --arg t "$tags" \
    '($t | split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0)))')
  jq -cn --arg file "$f" --arg title "${title:-Untitled idea}" --arg created "$created" \
    --arg status "${status:-new}" --arg planned "$planned" --arg project "$project" \
    --argjson mtime "$mtime" --argjson tags "$tags_json" \
    '{file:$file, title:$title, created:$created, mtime:$mtime, tags:$tags,
      status:$status, planned:$planned, project:$project}'
}

# Every idea in the folder, newest first. Shared by `list` and `related` so
# there is one parser rather than two that can drift.
list_json() {
  local d="$1" f
  shopt -s nullglob
  local files=("$d"/*.md)
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "[]"
    return 0
  fi
  for f in "${files[@]}"; do parse_one "$f"; done | jq -cs 'sort_by(-.mtime)'
}

# Siblings worth reading before planning this one: a shared tag is worth 2, a
# shared title word 1, and it takes 2 to count -- so one shared tag qualifies
# and one incidental word does not. Returning [] is the point of the thing. An
# agent told to go and find prior art will find some whether or not it exists;
# this answers the question once, cheaply, and is allowed to answer "none".
related_json() {
  local d="$1" target="$2"
  list_json "$d" | jq -c --arg target "$target" '
    def stop: ["with","that","this","from","have","into","when","what","would",
               "could","should","about","some","more","than","then","they",
               "them","there","been","just","like","make","want","need","only",
               "also","does","where","which","because","after","before"];
    def words: ascii_downcase | gsub("[^a-z0-9]+"; " ") | split(" ")
               | map(select(length >= 4)) | . - stop | unique;
    def isect($a; $b): $a - ($a - $b);
    . as $all
    | ($all | map(select(.file == $target)) | .[0]) as $me
    | if $me == null then [] else
        ($me.tags // []) as $mytags
      | ($me.title // "" | words) as $mywords
      | $all
      | map(select(.file != $target))
      | map( isect(.tags; $mytags) as $st
           | (isect((.title | words); $mywords) - $st) as $sw
           | { file, title, status,
               shared: ((($st | map("#" + .)) + $sw) | unique),
               score: (($st | length) * 2 + ($sw | length)) } )
      | map(select(.score >= 2))
      | sort_by(-.score)
      | .[0:3]
      | map(del(.score))
      end'
}

case "$cmd" in
  list)
    list_json "$dir"
    ;;

  related)
    file="${3:-}"
    [[ -n $file ]] || fail "missing file"
    resolve_in_dir "$dir" "$file"
    related_json "$REAL_DIR" "$REAL_FILE"
    ;;

  reviewed)
    file="${3:-}"
    [[ -n $file ]] || fail "missing file"
    resolve_in_dir "$dir" "$file"
    fm_set "$REAL_FILE" status planned
    fm_set "$REAL_FILE" planned "$(date +%F)"
    ;;

  new)
    text="${3:-}"
    [[ -n $(printf '%s' "$text" | tr -d '[:space:]') ]] || fail "empty idea text"
    mkdir -p "$dir"

    ts=$(date +%Y-%m-%d-%H%M%S)
    created=$(date -Iseconds)
    first_line=$(printf '%s\n' "$text" | { grep -m1 -v '^[[:space:]]*$' || true; })
    slug=$(printf '%s' "$first_line" \
      | tr '[:upper:]' '[:lower:]' \
      | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
      | cut -c1-40)
    [[ -n $slug ]] || slug="idea"

    file="$dir/$ts-$slug.md"
    while [[ -e $file ]]; do
      ts="${ts}-${RANDOM}"
      file="$dir/$ts-$slug.md"
    done

    tags=$(printf '%s' "$text" \
      | { grep -oE '#[A-Za-z0-9_-]+' || true; } \
      | sed 's/^#//' | tr '[:upper:]' '[:lower:]' | sort -u | paste -sd, -)

    # Blank planning-brief headings appended after the captured text, so a
    # future planning pass (yours or an agent's) has somewhere to start.
    # Edit this block directly if you want different sections.
    IFS= read -r -d '' template_tail <<'TEMPLATE_EOF' || true

## Context


## Goal


## Constraints


## Open questions


## Plan

TEMPLATE_EOF

    {
      printf -- '---\n'
      printf 'created: %s\n' "$created"
      printf 'tags: %s\n' "$tags"
      printf 'status: new\n'
      printf -- '---\n\n'
      printf '## Idea\n%s\n' "$text"
      printf '%s' "$template_tail"
    } > "$file"

    notify "Idea logged" "${first_line:-New idea}"
    jq -cn --arg file "$file" '{file:$file}'
    ;;

  remove)
    file="${3:-}"
    [[ -n $file ]] || fail "missing file"
    resolve_in_dir "$dir" "$file"
    rm -f -- "$REAL_FILE"
    ;;

  set)
    file="${3:-}"
    key="${4:-}"
    value="${5:-}"
    [[ -n $file ]] || fail "missing file"
    [[ -n $key ]] || fail "missing key"
    # Whitelisted: `created` and `tags` are the user's own words, written once
    # at capture time, and nothing downstream may rewrite them.
    case "$key" in
      status | planned | project) ;;
      *) fail "refusing to set frontmatter key: $key" ;;
    esac
    resolve_in_dir "$dir" "$file"
    fm_set "$REAL_FILE" "$key" "$value"
    ;;

  search)
    query="${3:-}"
    if [[ -z $query ]]; then
      echo "[]"
      exit 0
    fi
    real_dir=$(realpath -e "$dir") || fail "ideas dir not found: $dir"
    # Fixed-string, case-insensitive, filenames only -- the panel already has
    # the titles and tags, so this only has to answer "which bodies match".
    { grep -rilF --include='*.md' -e "$query" "$real_dir" || true; } \
      | jq -Rcs 'split("\n") | map(select(length > 0))'
    ;;

  tags)
    real_dir=$(realpath -e "$dir") || fail "ideas dir not found: $dir"
    shopt -s nullglob
    files=("$real_dir"/*.md)
    if [[ ${#files[@]} -eq 0 ]]; then
      echo "[]"
      exit 0
    fi
    for f in "${files[@]}"; do fm_get "$f" tags; echo; done \
      | tr ',' '\n' \
      | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
      | { grep -v '^$' || true; } \
      | sort | uniq -c | sort -k1,1nr -k2,2 \
      | jq -Rcs 'split("\n") | map(select(length > 0)
                 | capture("^\\s*(?<count>[0-9]+)\\s+(?<tag>.+)$")
                 | {tag: .tag, count: (.count | tonumber)})'
    ;;

  open)
    file="$dir"
    [[ -n $file && -f $file ]] || fail "file not found: ${file:-<none>}"
    # Prefer whatever the user has set as their markdown handler (Omawrite by
    # default, but Obsidian/VSCode/anything else they've associated with
    # text/markdown works too) over generic xdg-open, which resolves a .md
    # file's mimetype as text/plain here and would hand it to $EDITOR instead.
    desktop=$(xdg-mime query default text/markdown 2>/dev/null | head -1)
    if [[ -n $desktop ]] && command -v gtk-launch >/dev/null 2>&1; then
      gtk-launch "${desktop%.desktop}" "$file" >/dev/null 2>&1
    else
      xdg-open "$file" >/dev/null 2>&1
    fi
    ;;

  review)
    parse_handoff_flags "${@:3}"
    file="${ARGS[0]:-}"
    [[ -n $file ]] || fail "missing file"
    require_confirmed
    resolve_in_dir "$dir" "$file"
    require_agent
    require_agent_mode "$MODE"

    skill="$SPARKS_ROOT/agent/skills/spark-review/SKILL.md"

    # Plan and ask were picked so the agent proposes before it acts; say so
    # for the one write the review does make.
    approval_line=""
    [[ $MODE == auto ]] || approval_line=$'\nResearch first, then show the user the brief and write it into the file once\nthey approve.\n'

    # Everything else about the idea -- title, tags, status -- is in the file
    # the prompt points at, so naming it here would only be a second copy to
    # go stale. The overlap block is the exception: it is the one thing the
    # agent cannot work out without reading the whole folder.
    related_block=""
    related=$(related_json "$REAL_DIR" "$REAL_FILE")
    if [[ $(jq 'length' <<<"$related") -gt 0 ]]; then
      related_block=$(
        printf '\nIdeas that share tags with it -- read them, and ignore any that turn out\nto be unrelated:\n\n%s\n' \
          "$(jq -r '.[] | "  \(.file)\n      (\(.status))  \(.shared | join(" "))"' <<<"$related")"
      )
      related_block+=$'\n'
    fi

    prompt=$(
      cat <<PROMPT
Review this idea into a planning brief:

  $REAL_FILE
$related_block
Follow the spark-review skill. If your harness has no skill mechanism, read
this file and follow it instead:

  $skill

This review is read-only on this machine. The only file you may change is the
idea file above, and the only command you may run that changes anything is the
\`sparks reviewed\` line below. Do not install or remove packages, start, stop
or reload services, run hyprctl or omarchy commands that change state, edit
configuration, or run git commands that write. If a question can only be
answered by changing something, leave it unverified and put it in the brief as
a step for the user.
sudo and pkexec are not used by a review.
$approval_line
When the brief is written, run:

  $SPARKS_ROOT/bin/sparks reviewed "$REAL_DIR" "$REAL_FILE"
PROMPT
    )

    # Start in the ideas folder so sibling ideas are readable, and so
    # omarchy-agent's "\$PWD is \$HOME" redirect into ~/Work doesn't fire.
    cd "$REAL_DIR"
    launch_agent "$MODE" "$prompt"
    ;;

  create)
    parse_handoff_flags "${@:3}"
    file="${ARGS[0]:-}"
    projects_root="${ARGS[1]:-$HOME/Work}"
    [[ -n $file ]] || fail "missing file"
    require_confirmed
    resolve_in_dir "$dir" "$file"
    require_agent
    require_agent_mode "$MODE"

    if ! brief_filled "$REAL_FILE"; then
      notify "Review this idea first" "Its planning brief is still empty."
      fail "planning brief is empty -- run 'sparks review' first"
    fi

    base=$(basename "$REAL_FILE" .md)
    slug=$(printf '%s' "$base" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}(-[0-9]+)?-//')
    [[ -n $slug ]] || slug="$base"
    proj="$projects_root/$slug"

    if [[ -e $proj && -n $(ls -A "$proj" 2>/dev/null) ]]; then
      notify "Workspace already exists" "$proj"
      fail "workspace directory exists and is not empty: $proj"
    fi

    mkdir -p "$proj"
    git -C "$proj" init -q >/dev/null 2>&1 || true
    # A symlink, not a copy: the brief and the idea note stay one document, so
    # the plan the agent keeps current is the note the user opens from the bar.
    ln -sfn "$REAL_FILE" "$proj/BRIEF.md"

    fm_set "$REAL_FILE" status creating
    fm_set "$REAL_FILE" project "$proj"

    skill="$SPARKS_ROOT/agent/skills/spark-create/SKILL.md"

    prompt=$(
      cat <<PROMPT
Make this idea real. Its brief is already written:

  workspace: $proj
  brief:     $proj/BRIEF.md
             a symlink to $REAL_FILE -- edit it in place, never replace it

Follow the spark-create skill. If your harness has no skill mechanism, read
this file and follow it instead:

  $skill

Work inside the workspace. Before doing anything outside it -- installing or
removing packages, services, anything under ~/.config, the compositor or
keybindings, pushing, deploying, accounts, spending money -- ask the user about
that specific action and wait for an explicit yes.
sudo and pkexec are not used without a yes for that exact command.
PROMPT
    )

    cd "$proj"
    launch_agent "$MODE" "$prompt"
    ;;

  *)
    fail "unknown command: $cmd"
    ;;
esac
